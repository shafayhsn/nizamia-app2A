{
  "name": "nizamia-app2a-desktop",
  "version": "1.0.3",
  "private": true,
  "description": "NZOS desktop for Mac and Windows",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dmg --x64",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.nizamia.app2a.desktop",
    "productName": "NZOS",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "desktopOnline.cjs",
      "package.json",
      "localDatabase.cjs",
      "snapshotImport.cjs",
      "snapshotReplaceGuard.cjs",
      "snapshotInspect.cjs",
      "snapshotViewer.cjs",
      "offlineWorkspace.cjs",
      "offlineDraftPreview.cjs",
      "offlineDraftRecovery.cjs",
      "offlineReportLayout.cjs",
      "offlineReportPresets.cjs",
      "offlinePersonalNotes.cjs",
      "offlineEditCoordinator.cjs",
      "offlineSignedDraftGrant.cjs",
      "offlineAuthorizationClient.cjs",
      "offlineGlobalSearch.cjs",
      "offlinePageCoverage.cjs",
      "offlineSystemReports.cjs",
      "offlineCrossModuleReports.cjs",
      "offlineSystemReportExport.cjs",
      "offlineProductionBalance.cjs",
      "offlineReadiness.cjs",
      "offlineTrustedGrantBroker.cjs",
      "offlineSyncClient.cjs",
      "offlineSyncReconciliation.cjs",
      "offlineSyncCoordinator.cjs",
      "offlineOperationalExceptions.cjs",
      "snapshotStartup.cjs",
      "offlineCsvExport.cjs",
      "offlineDraft.cjs",
      "offlineDraftJournal.cjs",
      "offlineSyncPlanner.cjs",
      "offlineDraftAuthorization.cjs",
      "offlineLoginPolicy.cjs",
      "offlineAuthVerifier.cjs",
      "offlineCredentialStore.cjs",
      "offlineAuthService.cjs",
      "offlineSessionManager.cjs",
      "offlineEnrollmentProof.cjs",
      "snapshotViewerPreload.cjs",
      "snapshotViewer.html",
      "snapshotViewerRenderer.js",
      "offline.html",
      "standaloneRecords.cjs",
      "offlineMutationOutbox.cjs",
      "offlineMutationPlan.cjs",
      "legacyMutationReview.cjs",
      "shipmentStatusMutation.cjs",
      "orderDetailsMutation.cjs",
      "orderRemoval.cjs",
      "orderSectionCopy.cjs",
      "area3Mutation.cjs",
      "operationalRecords.cjs",
      "catalogRecords.cjs",
      "businessDocuments.cjs",
      "privateDownload.cjs",
      "poMatrixSync.cjs",
      "standaloneForms.cjs",
      "localDesktopAuth.cjs",
      "offlineOms.cjs",
      "desktopUpdates.cjs",
      "desktopUpdateBackup.cjs",
      "desktopInstallGuard.cjs",
      "desktopDmgPreflight.cjs",
      "desktopReplaceRollback.cjs",
      "desktopMacUpdateHelper.sh",
      "desktopUpdateLaunch.cjs",
      "desktopLocalBackup.cjs",
      "offlineSchemaAlignment.cjs",
      "offlineSchemaMigration.cjs",
      "offlineSchemaStartup.cjs",
      "schema/public-schema-inventory.json",
      "offlinePendingStatus.cjs",
      "desktopSyncLoop.cjs",
      "desktopCloudSession.cjs",
      "snapshotDownloadClient.cjs",
      "applyCloudSnapshot.cjs",
      "snapshotMerge.cjs",
      "nzosWorkspace.cjs",
      "permissions.mjs",
      "staffOperations.cjs"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/Nizamia-App-2A.icns",
      "artifactName": "NZOS-${version}-Intel.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/Nizamia-App-2A.ico",
      "artifactName": "NZOS-${version}-Windows-x64-Setup.${ext}"
    },
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../src/assets",
        "to": "brand-assets"
      },
      {
        "from": "../QMS Excel formats.zip",
        "to": "brand-assets/QMS Excel formats.zip"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "createStartMenuShortcut": true,
      "shortcutName": "NZOS",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "sql.js": "1.13.0",
    "xlsx": "0.18.5"
  }
}
