{
  "name": "nizamia-app2a-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Nizamia App-2A desktop CP-18 SQLite foundation (online app with local metadata database)",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac dmg --x64",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.nizamia.app2a.desktop",
    "productName": "Nizamia App-2A",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "package.json",
      "localDatabase.cjs",
      "snapshotImport.cjs",
      "snapshotReplaceGuard.cjs",
      "snapshotInspect.cjs",
      "snapshotViewer.cjs",
      "offlineWorkspace.cjs",
      "offlineDraftPreview.cjs",
      "offlineDraftRecovery.cjs",
      "offlineReportLayout.cjs",
      "offlineReportPresets.cjs",
      "offlinePersonalNotes.cjs",
      "offlineEditCoordinator.cjs",
      "offlineSignedDraftGrant.cjs",
      "offlineAuthorizationClient.cjs",
      "snapshotStartup.cjs",
      "offlineCsvExport.cjs",
      "offlineDraft.cjs",
      "offlineDraftJournal.cjs",
      "offlineSyncPlanner.cjs",
      "offlineDraftAuthorization.cjs",
      "offlineLoginPolicy.cjs",
      "offlineAuthVerifier.cjs",
      "offlineCredentialStore.cjs",
      "offlineAuthService.cjs",
      "offlineSessionManager.cjs",
      "offlineEnrollmentProof.cjs",
      "snapshotViewerPreload.cjs",
      "snapshotViewer.html",
      "snapshotViewerRenderer.js",
      "offline.html"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/Nizamia-App-2A.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/Nizamia-App-2A.ico"
    },
    "asarUnpack": [
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "sql.js": "1.13.0"
  }
}
