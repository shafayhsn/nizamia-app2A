# A desktop build uses the bundled local adapter. Online sign-in uses the deployed Nizamia API.
APP2A_DESKTOP_BUILD=1
# Public browser configuration when separately building the web client:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server deployment only. Keep production values in the hosting provider's secret store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
